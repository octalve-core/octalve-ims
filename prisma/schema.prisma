// Prisma schema for octalve-ims (Postgres). Ported from the original MongoDB
// schema; see docs/auth-system-port-plan.md for the auth-model provenance
// (RefreshToken/VerificationToken/LoginAttempt ported from Proplity) and
// /home/rojitech/.claude/plans/clever-moseying-haven.md for the Milestone 0
// migration plan (tenancy/RBAC models, id-strategy, relation-promotion scope).
//
// Relation-promotion scope (Milestone 0): entity-to-entity business
// relationships that were load-bearing for existing features (catalog,
// stock, orders/invoices) are promoted to real typed relations below.
// "Actor" fields — who created/updated/deleted a row, or who a row is
// informally linked to for display purposes (userId, createdBy, updatedBy,
// deletedBy, assignedToId, and optional cross-links like SupportTicket's
// productId/orderId/supplierId or ProductReview's productId/orderId) — are
// deliberately LEFT as plain unconstrained String columns rather than typed
// relations. Promoting them now would require resolving an onDelete policy
// and a User back-relation shape for each one speculatively; that's real
// design work better driven by the feature that actually needs the join
// (e.g. the client-portal feature is what should decide whether
// Order.clientId becomes a real relation), not done blind in Milestone 0.
//
// Run: npx prisma generate (after schema changes); use prisma/client for DB
// access. RLS policies are NOT managed here — see prisma/rls/.

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Tenancy & RBAC
// ---------------------------------------------------------------------------

model Business {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  users User[]
  roles Role[]
}

model Role {
  id          String       @id @default(cuid())
  businessId  String? // null = Core's 2 fixed system roles (Admin/Staff), not tenant-owned
  name        String
  isSystem    Boolean      @default(false) // Core's Admin/Staff — not editable via UI
  warehouseId String? // Pro+: scope a role to one warehouse
  business    Business?    @relation(fields: [businessId], references: [id], onDelete: Cascade)
  permissions Permission[]
  users       User[]

  @@unique([businessId, name])
}

model Permission {
  id       String @id @default(cuid())
  roleId   String
  resource String // Products | Stock | Orders | Purchasing | Invoicing | Users | Reports
  action   String // view | create | edit | delete | approve
  role     Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([roleId, resource, action])
}

// ---------------------------------------------------------------------------
// Auth — ported from Proplity, see docs/auth-system-port-plan.md
// ---------------------------------------------------------------------------

model RefreshToken {
  id         String    @id @default(cuid())
  userId     String
  tokenHash  String    @unique // SHA-256 hex of the raw opaque token; raw value never stored
  familyId   String // shared across every token descended from one login
  revokedAt  DateTime? // null = active; set = rotated-away or force-revoked
  replacedBy String? // tokenHash of the successor token (audit trail only, not used for lookups)
  expiresAt  DateTime  @db.Timestamptz(3)
  createdAt  DateTime  @default(now()) @db.Timestamptz(3)
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([familyId])
}

model VerificationToken {
  id        String   @id @default(cuid())
  userId    String   @unique // a user has at most one live verification token
  tokenHash String   @unique
  expiresAt DateTime @db.Timestamptz(3)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model LoginAttempt {
  id         String   @id @default(cuid())
  identifier String // e.g. "register:<ip>", "<ip>:<email>", "refresh:<ip>"
  userId     String?
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  createdAt  DateTime @default(now()) @db.Timestamptz(3)

  @@index([identifier, createdAt])
}

// ---------------------------------------------------------------------------
// Catalog & taxonomy
// ---------------------------------------------------------------------------

model Category {
  id          String    @id @default(cuid())
  name        String
  userId      String // actor — created by
  businessId  String?
  status      Boolean   @default(true)
  description String?
  notes       String?
  createdAt   DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime? @db.Timestamptz(3)
  createdBy   String
  updatedBy   String?
  products    Product[]
}

model Product {
  id               String            @id @default(cuid())
  categoryId       String
  businessId       String?
  createdAt        DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime?         @db.Timestamptz(3)
  name             String
  price            Float
  quantity         BigInt
  reservedQuantity BigInt            @default(0)
  sku              String            @unique
  status           String
  supplierId       String // primary/default supplier — kept as a plain scalar for backward
  // compatibility with existing single-supplier code paths; ProductSupplier
  // below is an additive many-to-many for Pro+ features that need it, not a
  // replacement (see docs/auth-system-port-plan.md-adjacent Milestone 0 notes)
  userId           String // actor — created by
  createdBy        String
  updatedBy        String?
  qrCodeUrl        String?
  qrCodeFileId     String?
  imageUrl         String?
  imageFileId      String?
  expirationDate   DateTime?
  deletedAt        DateTime? // soft-delete: set when product has order history and is "deleted"
  deletedBy        String?
  category         Category          @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  orderItems       OrderItem[]
  suppliers        ProductSupplier[]
  stockAllocations StockAllocation[]
  stockTransfers   StockTransfer[]

  @@index([deletedAt])
}

/// Product <-> Supplier many-to-many, own SKU/price/lead-time per pairing.
/// Pattern adopted from inventory-management-ui-main (see PRD data-model
/// section) — replaces the old single Product.supplierId FK.
model ProductSupplier {
  id            String   @id @default(cuid())
  productId     String
  supplierId    String
  supplierSku   String?
  supplierPrice Float?
  leadTimeDays  Int?
  notes         String?
  createdAt     DateTime @default(now()) @db.Timestamptz(3)
  product       Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  supplier      Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)

  @@unique([productId, supplierId])
}

// ---------------------------------------------------------------------------
// Stock & warehousing
// ---------------------------------------------------------------------------

model Warehouse {
  id               String            @id @default(cuid())
  name             String
  address          String?
  type             String?
  status           Boolean           @default(true)
  userId           String // actor — created by
  businessId       String?
  createdAt        DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime?         @db.Timestamptz(3)
  createdBy        String
  updatedBy        String?
  orderItems       OrderItem[]
  stockAllocations StockAllocation[]
  transfersFrom    StockTransfer[]   @relation("StockTransferFrom")
  transfersTo      StockTransfer[]   @relation("StockTransferTo")

  @@index([userId])
}

model StockAllocation {
  id               String    @id @default(cuid())
  productId        String
  warehouseId      String
  businessId       String?
  quantity         BigInt    @default(0)
  reservedQuantity BigInt    @default(0)
  userId           String // actor — created by
  createdAt        DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime? @db.Timestamptz(3)
  product          Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  warehouse        Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)

  @@unique([productId, warehouseId])
  @@index([productId])
  @@index([warehouseId])
}

model StockTransfer {
  id              String    @id @default(cuid())
  productId       String
  fromWarehouseId String
  toWarehouseId   String
  businessId      String?
  quantity        BigInt
  status          String    @default("pending") // pending, completed, cancelled
  notes           String?
  userId          String // actor — initiated by
  createdAt       DateTime  @default(now()) @db.Timestamptz(3)
  completedAt     DateTime? @db.Timestamptz(3)
  product         Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  fromWarehouse   Warehouse @relation("StockTransferFrom", fields: [fromWarehouseId], references: [id], onDelete: Restrict)
  toWarehouse     Warehouse @relation("StockTransferTo", fields: [toWarehouseId], references: [id], onDelete: Restrict)

  @@index([productId])
  @@index([fromWarehouseId])
  @@index([toWarehouseId])
  @@index([status])
}

// ---------------------------------------------------------------------------
// CRM — vendors & customers
// ---------------------------------------------------------------------------

model Supplier {
  id          String            @id @default(cuid())
  name        String
  userId      String // actor — created by
  businessId  String?
  status      Boolean           @default(true)
  description String?
  notes       String?
  createdAt   DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime?         @db.Timestamptz(3)
  createdBy   String
  updatedBy   String?
  products    ProductSupplier[]
}

// ---------------------------------------------------------------------------
// Sales & order fulfillment
// ---------------------------------------------------------------------------

model Order {
  id                    String      @id @default(cuid())
  orderNumber           String      @unique
  userId                String // actor — created by
  clientId              String? // which client this order is for (not promoted, see file header)
  businessId            String?
  status                String      @default("pending") // pending, confirmed, processing, shipped, delivered, cancelled
  paymentStatus         String      @default("unpaid") // unpaid, paid, refunded, partial
  subtotal              Float       @default(0)
  tax                   Float?
  shipping              Float?
  discount              Float?
  total                 Float       @default(0)
  shippingAddress       Json?
  billingAddress        Json?
  notes                 String?
  trackingNumber        String?
  trackingCarrier       String?
  trackingUrl           String?
  labelUrl              String?
  estimatedDelivery     DateTime?
  shippedAt             DateTime?
  deliveredAt           DateTime?
  cancelledAt           DateTime?
  stripePaymentIntentId String?
  createdAt             DateTime    @default(now()) @db.Timestamptz(3)
  updatedAt             DateTime?   @db.Timestamptz(3)
  createdBy             String
  updatedBy             String?
  items                 OrderItem[]
  invoice               Invoice?
}

model OrderItem {
  id            String     @id @default(cuid())
  orderId       String
  productId     String
  productName   String // snapshot at order time
  sku           String?
  quantity      Int
  price         Float // unit price snapshot
  subtotal      Float
  warehouseId   String? // picked source warehouse when product has allocations
  warehouseName String? // snapshot at order time
  createdAt     DateTime   @default(now()) @db.Timestamptz(3)
  order         Order      @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product       Product    @relation(fields: [productId], references: [id], onDelete: Restrict)
  warehouse     Warehouse? @relation(fields: [warehouseId], references: [id], onDelete: SetNull)
}

// ---------------------------------------------------------------------------
// Financial & invoicing
// ---------------------------------------------------------------------------

model Invoice {
  id                    String    @id @default(cuid())
  invoiceNumber         String    @unique
  orderId               String    @unique
  userId                String // actor — created by
  clientId              String? // not promoted, see file header
  businessId            String?
  status                String    @default("draft") // draft, sent, paid, overdue, cancelled
  subtotal              Float     @default(0)
  tax                   Float?
  shipping              Float?
  discount              Float?
  total                 Float     @default(0)
  amountPaid            Float     @default(0)
  amountDue             Float     @default(0)
  dueDate               DateTime
  issuedAt              DateTime  @default(now()) @db.Timestamptz(3)
  sentAt                DateTime? @db.Timestamptz(3)
  paidAt                DateTime? @db.Timestamptz(3)
  cancelledAt           DateTime? @db.Timestamptz(3)
  paymentLink           String?
  stripePaymentIntentId String?
  notes                 String?
  billingAddress        Json?
  createdAt             DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt             DateTime? @db.Timestamptz(3)
  createdBy             String
  updatedBy             String?
  order                 Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([userId, status, dueDate])
}

// ---------------------------------------------------------------------------
// Users & notifications
// ---------------------------------------------------------------------------

model User {
  id                String             @id @default(cuid())
  createdAt         DateTime           @default(now()) @db.Timestamptz(3)
  email             String             @unique
  name              String
  password          String
  updatedAt         DateTime?          @db.Timestamptz(3)
  username          String?            @unique
  googleId          String?
  image             String?
  /// Legacy free-text fast-path role, mirrored into the JWT `role` claim
  /// (see docs/auth-system-port-plan.md). Core's 2 fixed roles read this;
  /// Pro+ custom-role permission checks use roleRelation/roleId instead.
  role              String? // user | admin | supplier | client | retailer
  roleId            String?
  businessId        String?
  emailPreferences  Json?
  roleRelation      Role?              @relation(fields: [roleId], references: [id], onDelete: SetNull)
  notifications     Notification[]
  refreshTokens     RefreshToken[]
  verificationToken VerificationToken?
  loginAttempts     LoginAttempt[]
  business          Business?          @relation(fields: [businessId], references: [id])
}

model Notification {
  id        String    @id @default(cuid())
  userId    String
  type      String // "low_stock", "stock_out", "order_confirmation", "order_status_update", etc.
  title     String
  message   String
  link      String?
  read      Boolean   @default(false)
  createdAt DateTime  @default(now()) @db.Timestamptz(3)
  readAt    DateTime? @db.Timestamptz(3)
  metadata  Json?
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, read, createdAt])
}

// ---------------------------------------------------------------------------
// Support & reviews
// ---------------------------------------------------------------------------

model SupportTicket {
  id           String               @id @default(cuid())
  subject      String
  description  String
  status       String               @default("open") // open, in_progress, resolved, closed
  priority     String               @default("medium") // low, medium, high, urgent
  userId       String // actor — creator
  assignedToId String? // actor — assignee, not promoted, see file header
  productId    String? // optional link, not promoted, see file header
  orderId      String? // optional link, not promoted, see file header
  supplierId   String? // optional link, not promoted, see file header
  notes        String?
  createdAt    DateTime             @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime?            @db.Timestamptz(3)
  replies      SupportTicketReply[]

  @@index([userId])
  @@index([status])
  @@index([assignedToId])
  @@index([createdAt])
}

model SupportTicketReply {
  id            String        @id @default(cuid())
  ticketId      String
  userId        String // actor — author
  body          String
  createdAt     DateTime      @default(now()) @db.Timestamptz(3)
  supportTicket SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([ticketId])
  @@index([userId])
  @@index([createdAt])
}

model ProductReview {
  id          String    @id @default(cuid())
  productId   String // not promoted, see file header
  userId      String // actor — author
  orderId     String? // not promoted, see file header
  orderItemId String? // not promoted, see file header
  productName String // snapshot at review time
  productSku  String?
  rating      Int // 1-5
  comment     String
  status      String    @default("pending") // pending, approved, rejected
  createdAt   DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime? @db.Timestamptz(3)

  @@index([productId])
  @@index([orderId, productId, userId])
  @@index([userId])
  @@index([orderId])
  @@index([status])
  @@index([rating])
  @@index([createdAt])
}

// ---------------------------------------------------------------------------
// Operations — import, system config, audit
// ---------------------------------------------------------------------------

model ImportHistory {
  id          String    @id @default(cuid())
  userId      String // actor
  businessId  String?
  importType  String // "products", "orders", "suppliers", "categories"
  fileName    String
  fileSize    Int
  totalRows   Int
  successRows Int
  failedRows  Int
  errors      Json?
  status      String    @default("completed") // "processing", "completed", "failed"
  createdAt   DateTime  @default(now()) @db.Timestamptz(3)
  completedAt DateTime? @db.Timestamptz(3)
}

model SystemConfig {
  id          String    @id @default(cuid())
  businessId  String?
  key         String    @unique
  value       String
  type        String    @default("string") // string, number, boolean, json
  label       String
  description String?
  category    String    @default("general") // general, email, shipping, payment, notifications
  isPublic    Boolean   @default(false)
  createdAt   DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime? @db.Timestamptz(3)
  updatedBy   String? // actor

  @@index([category])
  @@index([isPublic])
}

/// Audit Log — entityId is deliberately NOT a typed relation: its target
/// model varies by entityType (polymorphic), which Postgres FKs can't
/// express. Do not "fix" this into a foreign key.
model AuditLog {
  id         String   @id @default(cuid())
  userId     String // actor
  businessId String?
  action     String // create, update, delete, login, logout, etc.
  entityType String // product, order, invoice, user, etc.
  entityId   String? // polymorphic — see comment above
  details    Json?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now()) @db.Timestamptz(3)

  @@index([userId])
  @@index([action])
  @@index([entityType])
  @@index([createdAt])
}
