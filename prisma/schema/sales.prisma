// Sales, order fulfillment & invoicing. TIER: core (return/transfer order
// variants and Stripe/email-delivery fields are additive Pro-tier UI over
// these same models — no separate models needed for that yet).

model Order {
  id                    String      @id @default(cuid())
  orderNumber           String      @unique
  userId                String // actor — created by
  clientId              String? // which client this order is for (not promoted, see schema.prisma header)
  businessId            String?
  status                String      @default("pending") // pending, confirmed, processing, shipped, delivered, cancelled
  paymentStatus         String      @default("unpaid") // unpaid, paid, refunded, partial
  subtotal              Float       @default(0)
  tax                   Float?
  shipping              Float?
  discount              Float?
  total                 Float       @default(0)
  shippingAddress       Json?
  billingAddress        Json?
  notes                 String?
  trackingNumber        String?
  trackingCarrier       String?
  trackingUrl           String?
  labelUrl              String?
  estimatedDelivery     DateTime?
  shippedAt             DateTime?
  deliveredAt           DateTime?
  cancelledAt           DateTime?
  stripePaymentIntentId String?
  createdAt             DateTime    @default(now()) @db.Timestamptz(3)
  updatedAt             DateTime?   @db.Timestamptz(3)
  createdBy             String
  updatedBy             String?
  items                 OrderItem[]
  invoice               Invoice?
}

model OrderItem {
  id            String     @id @default(cuid())
  orderId       String
  productId     String
  productName   String // snapshot at order time
  sku           String?
  quantity      Int
  price         Float // unit price snapshot
  subtotal      Float
  warehouseId   String? // picked source warehouse when product has allocations
  warehouseName String? // snapshot at order time
  createdAt     DateTime   @default(now()) @db.Timestamptz(3)
  order         Order      @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product       Product    @relation(fields: [productId], references: [id], onDelete: Restrict)
  warehouse     Warehouse? @relation(fields: [warehouseId], references: [id], onDelete: SetNull)
}

model Invoice {
  id                    String    @id @default(cuid())
  invoiceNumber         String    @unique
  orderId               String    @unique
  userId                String // actor — created by
  clientId              String? // not promoted, see schema.prisma header
  businessId            String?
  status                String    @default("draft") // draft, sent, paid, overdue, cancelled
  subtotal              Float     @default(0)
  tax                   Float?
  shipping              Float?
  discount              Float?
  total                 Float     @default(0)
  amountPaid            Float     @default(0)
  amountDue             Float     @default(0)
  dueDate               DateTime
  issuedAt              DateTime  @default(now()) @db.Timestamptz(3)
  sentAt                DateTime? @db.Timestamptz(3)
  paidAt                DateTime? @db.Timestamptz(3)
  cancelledAt           DateTime? @db.Timestamptz(3)
  paymentLink           String?
  stripePaymentIntentId String?
  notes                 String?
  billingAddress        Json?
  createdAt             DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt             DateTime? @db.Timestamptz(3)
  createdBy             String
  updatedBy             String?
  order                 Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([userId, status, dueDate])
}

// ISS-0008: durable per-Stripe-Checkout-Session dedup ledger. Before this
// model, "already applied" was decided by comparing a Stripe PaymentIntent
// id against the single LATEST id stored on Order/Invoice — once a newer
// session overwrote that pointer, replaying an OLDER (already-paid)
// session's return URL looked unapplied again and re-credited amountPaid
// for money that never actually moved. sessionId @unique makes every
// individual Checkout Session permanently un-replayable, not just the most
// recent one, and doubles as the concurrency primitive: the application
// code inserts this row as the FIRST statement of the transaction that
// applies the charge, so two concurrent callers racing the same session id
// (the webhook and the browser-return path both fire per REQ-0209) can
// never both win — whichever insert loses the unique constraint aborts its
// whole transaction, including any money it attempted to write.
model ProcessedPayment {
  id              String   @id @default(cuid())
  sessionId       String   @unique
  paymentIntentId String?
  orderId         String?
  invoiceId       String?
  amount          Float
  createdAt       DateTime @default(now()) @db.Timestamptz(3)

  @@index([invoiceId])
}
